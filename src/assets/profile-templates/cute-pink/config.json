    "_模板级别": {
      "avatarX": "头像X位置（相对画布 0-1）",
      "avatarY": "头像Y位置（相对画布 0-1）",
      "zeroLabelAvatarY": "0标签时头像Y位置（相对画布 0-1）",
      "avatarSize": "头像大小（相对画布宽度 0-1）",
      "avatarFrameOffsetX": "头像边框X偏移（相对画布宽度，正=右移，负=左移）",
      "avatarFrameOffsetY": "头像边框Y偏移（相对画布高度，正=下移，负=上移）"
    },
    "_标签级别": {
      "type": "标签类型（name/昵称=昵称，标签1/label1=第1个标签）",
      "x": "文字X位置（相对画布 0-1）",
      "y": "文字Y位置（相对画布 0-1）",
      "zeroLabelY": "0标签时文字Y位置（相对画布 0-1）",
      "backgroundImage": "背景图文件名",
      "bgScale": "背景图缩放（0.5=半大, 1.0=原始, 2.0=2倍大）",
      "bgOffsetX": "背景图X偏移（相对画布宽度，正=右移，负=左移）",
      "bgOffsetY": "背景图Y偏移（相对画布高度，正=下移，负=上移）",
      "textColor": "文字颜色（#RRGGBB）",
      "fontSize": "字体大小（会根据画布缩放）",
      "rotation": "旋转角度（度，正=顺时针）",
      "strokeColor": "内层描边颜色",
      "strokeWidth": "内层描边粗细",
      "stroke2Color": "外层描边颜色（在最外面）",
      "stroke2Width": "外层描边粗细",
      "fontFamily": "字体名（不含.ttf，需在 assets/fonts 放置）",
      "useCommonStyle": "是否继承 commonLabelStyle 样式"
    }
  },

